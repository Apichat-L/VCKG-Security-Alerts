# Copy to .env (lab_env/.env, git-ignored). Dummy credentials for an isolated lab only.
WAZUH_VERSION=4.9.2

# PostgreSQL superuser (postgres) password
POSTGRES_PASSWORD=Passw0rd!

# Files-SMB account for the [finance] share ([public] is guest)
SMB_USER=alice
SMB_PASSWORD=Passw0rd!

# Office workstations (SSH logins)
ADMIN_PC_USER=alice
ADMIN_PC_PASSWORD=Passw0rd!
DEP_PC_USER=bob
DEP_PC_PASSWORD=Passw0rd!
DEV_PC_USER=carol
DEV_PC_PASSWORD=Passw0rd!

# Mail (IMAP login / mailbox dave@lab.local)
MAIL_USER=dave
MAIL_PASSWORD=Passw0rd!

# HR-DB (MariaDB). HR_DB_PASSWORD is the hr_app account; it must match
# hosts/hr-app/webapp/hr/META-INF/context.xml (stored in the HR portal's config, as on a real server)
HR_DB_ROOT_PASSWORD=Passw0rd!
HR_DB_PASSWORD=Passw0rd!

# Gitea site administrator
GITEA_ADMIN_USER=gitadmin
GITEA_ADMIN_PASSWORD=Passw0rd!

# MGMT bastion (SSH login with sudo) and Grafana admin
JUMP_USER=ops
JUMP_PASSWORD=Passw0rd!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Passw0rd!

# 1 = lab hosts can reach the real internet through the firewall (off by default)
FW_ALLOW_EGRESS=0
