# Shell scripts run inside Linux containers: keep LF line endings on Windows checkouts.
*.sh text eol=lf
*.conf text eol=lf
# Config files copied into Linux containers (the Dockerfiles also strip CRs, this keeps the checkout clean)
*.ini text eol=lf
*.yaml text eol=lf
*.jsp text eol=lf
hosts/dns/named.conf.* text eol=lf
hosts/dns/db.lab.local text eol=lf
